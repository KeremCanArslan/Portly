# Flutter tarafı — API endpoint'leri. pubspec.yaml asset olarak bundle eder.
# Lokal geliştirme (LAN):
API_BASE_URL_ANDROID=http://10.0.2.2:8000/api/v1
API_BASE_URL_LOCAL=http://127.0.0.1:8000/api/v1
API_BASE_URL_NETWORK=http://127.0.0.1:8000/api/v1

# Production (cloud) — Render deploy sonrası al ve buraya koy:
# Release build (flutter build apk --release) bu URL'i kullanır.
API_BASE_URL_PROD=https://your-backend.onrender.com/api/v1

ALLOWED_ORIGINS=*
