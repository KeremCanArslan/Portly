# Backend secret'ları — LOKAL dosya. Production'da Render env-var olarak ver.
# Bu dosya örnektir; gerçek .env asla git'e gitmez (.gitignore'da).

# Lokal: sqlite:///./portly.db
# Production: postgresql+psycopg://user:pass@host/dbname (Neon connection string)
DATABASE_URL=sqlite:///./portly.db

# JWT imzalama — python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# API key'ler — kendi hesabından al, asla paylaşma:
# - GEMINI: https://aistudio.google.com/apikey
# - NEWS:   https://newsapi.org/account
# - GROQ:   https://console.groq.com/keys
# - FINNHUB: https://finnhub.io/dashboard (ücretsiz; hisse temel/bilanço — yfinance
#            .info Render IP'de bloklu olduğunda gerçek F/K/ROE buradan gelir)
GEMINI_API_KEY=
NEWS_API_KEY=
GROQ_API_KEY=
FINNHUB_API_KEY=

# Production'da Flutter web ve mobil origin'lere kilitle.
# Lokal/demo için * kabul. Cloud'da: https://your-frontend.onrender.com vb.
ALLOWED_ORIGINS=*
PORTLY_ENV=development

# Şifre sıfırlama maili.
# ÖNEMLİ: Render (ve çoğu bulut) giden SMTP portlarını (25/465/587) bloklar
# → "Network is unreachable". Cloud'da Gmail SMTP ÇALIŞMAZ. Orada Brevo kullan.
#
# Brevo (transactional email, HTTPS/443) — Render'da çalışan yol:
#   1. https://www.brevo.com → ücretsiz hesap (300 mail/gün)
#   2. Senders → gönderici adresini doğrula (ör. kendi Gmail'in)
#   3. SMTP & API → API Keys → yeni key üret, buraya yaz
BREVO_API_KEY=
# Brevo'da doğrulanmış gönderici adresi (boşsa SMTP_USER'a düşer):
BREVO_SENDER_EMAIL=

# Gmail SMTP — yalnızca LOKAL geliştirme için (BREVO_API_KEY boşsa kullanılır).
# App Password (16 hane), gerçek şifre değil. https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Portly

# Rate limiter — opsiyonel. Yoksa in-memory'e düşer (tek worker'da çalışır).
REDIS_URL=

# Yahoo çıkış-IP çözümü (ücretsiz, opsiyonel): Cloudflare Worker vekil kökü.
# Boşsa Yahoo'ya doğrudan gidilir. Kurulum: infra/cloudflare-worker/README.md
YAHOO_PROXY_BASE=
